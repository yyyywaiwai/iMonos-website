---
interface Props {
  /** The landing page links to its own sections; other pages must jump back. */
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const home = isHome ? "" : "/";

const links = [
  { href: `${home}#features`, label: "Features" },
  { href: "/story", label: "Story" },
  { href: `${home}#download`, label: "Download" },
  {
    href: "https://discord.com/invite/DfRhN8uFjX",
    label: "Discord",
    external: true,
  },
];

const current = Astro.url.pathname;
---

<header
  class="sticky top-0 z-20 border-b border-border/60 bg-background/80 backdrop-blur-xl supports-backdrop-filter:bg-background/60"
>
  <div
    class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-6"
  >
    <a
      href="/"
      aria-label="iMons トップへ"
      class="rounded-sm text-base font-semibold tracking-tight focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
    >
      iMons
    </a>

    <nav aria-label="Primary" class="flex items-center gap-1 sm:gap-2">
      {
        links.map(({ href, label, external }) => (
          <a
            href={href}
            {...(external ? { target: "_blank", rel: "noreferrer" } : {})}
            aria-current={href === current ? "page" : undefined}
            class="rounded-md px-2 py-1.5 text-[0.8rem] font-medium text-muted-foreground transition-colors hover:text-foreground focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none aria-[current=page]:text-foreground sm:px-3 sm:text-sm"
          >
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

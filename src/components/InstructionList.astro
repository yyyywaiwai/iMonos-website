---
interface Props {
  /** `body` is trusted authored markup (may contain <strong> / <a>). */
  items: { title: string; body: string }[];
}

const { items } = Astro.props;
---

<ol class="mt-10 divide-y divide-border overflow-hidden rounded-xl ring-1 ring-foreground/10">
  {
    items.map(({ title, body }, i) => (
      <li class="flex gap-4 p-6">
        <span
          class="flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium tabular-nums text-muted-foreground"
          aria-hidden="true"
        >
          {i + 1}
        </span>
        <div class="min-w-0">
          <h3 class="font-medium tracking-tight">{title}</h3>
          <p
            class="mt-2 text-sm leading-7 text-muted-foreground [&_a]:text-foreground [&_a]:underline [&_a]:underline-offset-4 [&_strong]:font-medium [&_strong]:text-foreground"
            set:html={body}
          />
        </div>
      </li>
    ))
  }
</ol>
